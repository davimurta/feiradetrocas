# Copie para `.env` e ajuste. O `.env` está no .gitignore — nunca commite credenciais.
#
# Este arquivo serve para os dois modos:
#   - Docker  (docker compose up): use o DATABASE_URL com host `db`.
#   - Local   (npm run dev):       use o DATABASE_URL com host `localhost`.

# --- Docker (padrão do docker-compose.yml) ---------------------------------
DATABASE_URL="postgresql://postgres:postgres@db:5432/feira?schema=public"

# --- Local, sem Docker -----------------------------------------------------
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/feira?schema=public"

# OBRIGATÓRIO. Assina o cookie de sessão (HMAC-SHA256). Sem um valor real, as sessões
# ficam assinadas com um segredo default inseguro. Gere um:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque-por-um-valor-aleatorio"

# Fuso usado nos baldes de hora/dia dos gráficos do admin.
TZ_EVENTO="America/Sao_Paulo"

# Custo do scrypt (parâmetro N, potência de 2). Padrão 131072 (2^17), que consome cerca de
# 128 MB e 300 ms por verificação de senha. Baixe para 65536 ou 32768 se o servidor do evento
# for modesto: o valor fica gravado dentro de cada hash, então mudar aqui não invalida senha
# nenhuma, e o hash antigo é reescrito no custo novo no próximo login bem-sucedido.
# SCRYPT_N=131072

# --- Rate limiting da autenticação -----------------------------------------
# A chave principal é a IDENTIDADE (conta), nunca o IP: no dia da feira quase todo mundo
# sai pelo mesmo IP público da rede do colégio, e limitar por IP derrubaria o evento.

# RATE_LIMIT_ATIVO=true            # desligar só para depurar, nunca em produção
# RATE_LIMIT_FALHAS=5              # falhas de login por conta antes de bloquear
# RATE_LIMIT_JANELA_SEG=900        # janela em que essas falhas contam (15 min)
# RATE_LIMIT_BLOQUEIO_SEG=300      # bloqueio base; dobra a cada falha extra (backoff)
# RATE_LIMIT_BLOQUEIO_MAX_SEG=3600 # teto do backoff
# RATE_LIMIT_RETENCAO_HORAS=72     # por quanto tempo a auditoria de tentativas fica no banco

# O cadastro é mais duro: cada tentativa ali bate na API do colégio, e o portal
# provavelmente bloqueia a conta do aluno depois de N erros.
# RATE_LIMIT_CADASTRO_FALHAS=3
# RATE_LIMIT_CADASTRO_JANELA_SEG=900
# RATE_LIMIT_CADASTRO_BLOQUEIO_SEG=900

# Cadastro por convite: o balde é global, porque limitar por código tentado daria a cada
# chute um balde próprio, que é justamente o que um atacante quer ao varrer códigos. O teto é
# alto para não punir quem só errou de digitar.
# RATE_LIMIT_CONVITE_FALHAS=40
# RATE_LIMIT_CONVITE_JANELA_SEG=900
# RATE_LIMIT_CONVITE_BLOQUEIO_SEG=120

# Limite por IP: DESLIGADO até o ambiente de produção estar definido. Só faz sentido ligar
# depois de preencher PROXIES_CONFIAVEIS, senão ou não protege nada ou bloqueia o colégio.
# RATE_LIMIT_IP_ATIVO=false
# RATE_LIMIT_IP_FALHAS=200
# RATE_LIMIT_IP_CADASTRO_FALHAS=60

# Quantos proxies existem à frente do app (Railway, Vercel, nginx do colégio...). Com 0, o
# `x-forwarded-for` é ignorado por ser forjável, e o limite por IP fica sem chave.
# PROXIES_CONFIAVEIS=0

# --- API do Cotemig (vínculo de conta) -------------------------------------
# Somente GET, e só o endpoint /perfil. Não existe credencial de aplicação: quem autentica
# é o próprio aluno, uma única vez, no cadastro. A senha do portal nunca é armazenada.
# COTEMIG_TIMEOUT_MS=5000

# --- Login com Google (opcional, desligado) --------------------------------
# Só ligue depois de existir domínio público com HTTPS: o Google exige redirect URI https.
# O Google é método SECUNDÁRIO: vincula-se em /conta depois do cadastro pelo Cotemig, e
# sozinho nunca cria conta nem concede papel elevado.
# GOOGLE_AUTH_ENABLED=false
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="https://SEU_DOMINIO/api/auth/google/callback"
# GOOGLE_HD="cotemig.com.br"
# GOOGLE_DOMINIOS="cotemig.com.br,aluno.cotemig.com.br,faculdadecotemig.br,aluno.faculdadecotemig.br"

# --- Só para o docker-compose (opcionais) ----------------------------------
# APP_PORT=3000          # porta do app no host
# POSTGRES_PORT=5434     # porta do Postgres exposta no host (5432/5433 costumam estar ocupadas)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=feira
