// Feira de Trocas — schema do domínio de economia de fichas (COTEMIG).
//
// Novidades desta fase:
//  - Aprovação em duas pontas: a venda vira um `Pedido` com status `pendente` até o
//    comprador aprovar (o atendente já "aprova" ao criar). Só quando os dois aceitam é que
//    a venda é finalizada atomicamente (baixa de estoque + débito + auditoria).
//  - Unidades Barroca/Floresta: `unidade` em User e Item. Estoque/stacking e as telas
//    operacionais (recepção/stand/catálogo) são por unidade. A carteira (saldo) é global
//    por aluno; o admin enxerga todas as unidades.
//
// Invariantes mantidas: fichas inteiras; toda mudança de saldo/estoque em transação atômica;
// campos de lookup (email/carteira/código) únicos e indexados.

generator client {
  provider      = "prisma-client-js"
  // "native" = sua máquina; "debian-openssl-3.0.x" = runtime Linux do Railway (Nixpacks).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  participante
  atendente_entrada
  atendente_stand
  admin
}

enum Unidade {
  barroca
  floresta
}

enum TipoTransacao {
  credito_entrada
  debito_compra
  ajuste_manual
}

enum PedidoStatus {
  pendente // criado pelo stand, aguardando o comprador aprovar
  aprovado // os dois aceitaram; venda finalizada
  recusado // comprador recusou (ou finalização inviável: esgotado/saldo)
  cancelado // atendente cancelou antes da aprovação
}

enum ItemPendenteStatus {
  pendente // recebido na recepção, ainda não creditado nem no estoque
  producao // "push" feito: aluno creditado e item somado ao estoque
}

model User {
  id String @id @default(cuid())

  nome      String
  email     String  @unique
  senhaHash String? @map("senha_hash")
  provider  String  @default("password")

  papel   Papel   @default(participante)
  unidade Unidade @default(barroca)
  saldo   Int     @default(0)
  codigoCarteira String @unique @map("codigo_carteira")

  /// Conta que entrou com email fora do padrão de matrícula: fica pendente até o admin
  /// definir papel/unidade ("colocar uma rule"). Enquanto true, só vê a tela de pendência.
  pendente Boolean @default(false)

  /// Conta bloqueada pelo admin (via um reporte). Não faz login nem opera enquanto true.
  bloqueado Boolean @default(false)

  /// Versão da sessão. Vai assinada dentro do cookie; se divergir da linha do banco, a
  /// sessão é rejeitada. Incrementar aqui derruba todos os cookies daquele usuário
  /// (logout, bloqueio pelo admin, mudança de papel, troca de senha).
  sessionVersion Int @default(0) @map("session_version")

  /// Vínculo com o portal do Cotemig, provado uma única vez no cadastro. A API v1.3 não
  /// devolve campo `id`, então o identificador estável é o próprio `usuario` do portal
  /// (a matrícula), normalizado em minúsculas. Único: um aluno, uma conta na feira.
  /// A senha do portal NUNCA é guardada aqui nem em lugar nenhum.
  cotemigId      String?   @unique @map("cotemig_id")
  cotemigUsuario String?   @map("cotemig_usuario")
  vinculadoEm    DateTime? @map("vinculado_em")

  /// Convite que originou a conta, quando ela não veio de uma matrícula do Cotemig.
  /// Serve de auditoria: dá para saber por qual código cada visitante entrou.
  conviteId String?  @map("convite_id")
  convite   Convite? @relation(fields: [conviteId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contasExternas       ContaExterna[]
  convitesCriados      Convite[]      @relation("ConviteAutor")
  transacoes           Transacao[]    @relation("TransacoesDoUsuario")
  atendimentos         Transacao[]    @relation("TransacoesDoAtendente")
  pedidosComoComprador Pedido[]       @relation("PedidoComprador")
  pedidosComoAtendente Pedido[]       @relation("PedidoAtendente")
  entradasComoAluno    ItemPendente[] @relation("EntradaAluno")
  entradasComoAtendente ItemPendente[] @relation("EntradaAtendente")
  reportesRecebidos    Reporte[]      @relation("ReporteReportado")
  reportesFeitos       Reporte[]      @relation("ReporteReportante")

  @@map("users")
}

model Item {
  id         String  @id @default(cuid())
  codigo     String  @unique
  nome       String
  categoria  String
  valor      Int
  quantidade Int     @default(0)
  unidade    Unidade @default(barroca)

  /// Detalhe do item. Visível só para admin, atendente de entrada e comprador.
  descricao String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transacoes Transacao[]
  pedidos    Pedido[]

  // Stacking por unidade: um item por (nome, valor, unidade).
  @@unique([nome, valor, unidade])
  @@index([categoria, unidade])
  @@map("items")
}

model Transacao {
  id         String        @id @default(cuid())
  tipo       TipoTransacao
  valor      Int
  quantidade Int           @default(1)

  userId String @map("user_id")
  user   User   @relation("TransacoesDoUsuario", fields: [userId], references: [id])

  atendenteId String? @map("atendente_id")
  atendente   User?   @relation("TransacoesDoAtendente", fields: [atendenteId], references: [id])

  itemId String? @map("item_id")
  item   Item?   @relation(fields: [itemId], references: [id])

  pedido Pedido?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([itemId])
  // Índices do painel de métricas: as agregações do admin filtram por janela de tempo
  // (série temporal), por tipo dentro da janela (fichas emitidas/gastas) e por atendente.
  @@index([createdAt])
  @@index([tipo, createdAt])
  @@index([atendenteId, createdAt])
  @@map("transacoes")
}

/// Pedido de compra que exige aprovação do comprador (status `pendente` até os dois aceitarem).
model Pedido {
  id         String       @id @default(cuid())
  status     PedidoStatus @default(pendente)
  valor      Int
  quantidade Int          @default(1)

  itemId String @map("item_id")
  item   Item   @relation(fields: [itemId], references: [id])

  compradorId String @map("comprador_id")
  comprador   User   @relation("PedidoComprador", fields: [compradorId], references: [id])

  atendenteId String @map("atendente_id")
  atendente   User   @relation("PedidoAtendente", fields: [atendenteId], references: [id])

  aprovadoComprador Boolean @default(false) @map("aprovado_comprador")
  aprovadoAtendente Boolean @default(true) @map("aprovado_atendente")

  // Transação gerada na finalização (quando aprovado).
  transacaoId String?    @unique @map("transacao_id")
  transacao   Transacao? @relation(fields: [transacaoId], references: [id])

  motivoRecusa String? @map("motivo_recusa")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([compradorId, status])
  @@index([status, createdAt])
  // Comparativo de atividade por atendente no painel de métricas.
  @@index([atendenteId, status])
  @@map("pedidos")
}

/// Item recebido na recepção que aguarda o "push" para produção. Enquanto `pendente`, o
/// aluno ainda NÃO foi creditado e o item não aparece no catálogo. O push credita o aluno
/// e soma o item ao estoque (model Item), stacking por (nome, valor, unidade).
model ItemPendente {
  id         String  @id @default(cuid())
  codigo     String  @unique
  nome       String
  categoria  String
  valor      Int
  quantidade Int     @default(1)
  unidade    Unidade @default(barroca)
  descricao  String?

  alunoId String @map("aluno_id")
  aluno   User   @relation("EntradaAluno", fields: [alunoId], references: [id])

  atendenteId String @map("atendente_id")
  atendente   User   @relation("EntradaAtendente", fields: [atendenteId], references: [id])

  status    ItemPendenteStatus @default(pendente)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@index([status, unidade, createdAt])
  // Produtividade da recepção por atendente (painel de métricas).
  @@index([atendenteId, createdAt])
  @@map("itens_pendentes")
}

/// Denúncia feita pelo stand contra um comprador (ex.: recusa indevida, furto). O admin
/// analisa e pode bloquear a conta ou zerar o saldo do denunciado.
model Reporte {
  id        String  @id @default(cuid())
  motivo    String
  descricao String?

  reportadoId String @map("reportado_id")
  reportado   User   @relation("ReporteReportado", fields: [reportadoId], references: [id])

  reportanteId String @map("reportante_id")
  reportante   User   @relation("ReporteReportante", fields: [reportanteId], references: [id])

  pedidoId String? @map("pedido_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("reportes")
}

/// Código de convite para quem não tem matrícula no Cotemig (professores, visitantes,
/// convidados). É multiuso e vale por um período: a organização gera um punhado deles e
/// distribui, em vez de gerar um por pessoa. Sem código válido, nenhuma conta nasce por
/// este caminho, o que torna o cadastro imune a cadastro em massa.
model Convite {
  id        String  @id @default(cuid())
  codigo    String  @unique
  descricao String?
  unidade   Unidade

  expiraEm DateTime @map("expira_em")
  /// Teto de usos. `null` significa ilimitado dentro da validade.
  maxUsos  Int?     @map("max_usos")
  usos     Int      @default(0)
  ativo    Boolean  @default(true)

  criadoPorId String @map("criado_por_id")
  criadoPor   User   @relation("ConviteAutor", fields: [criadoPorId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  usuarios User[]

  @@index([ativo, expiraEm])
  @@map("convites")
}

/// Vínculo com um provedor externo de identidade (hoje só Google). Fica em modelo separado
/// para que uma conta possa ter mais de um provedor sem inchar `users`. O par
/// (provider, providerAccountId) é único: uma identidade externa aponta para uma conta só.
model ContaExterna {
  id                String @id @default(cuid())
  provider          String
  providerAccountId String @map("provider_account_id")
  email             String?

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("contas_externas")
}

/// Trilha de auditoria das tentativas de autenticação. Alimenta a tela do admin e serve
/// para detectar volume anômalo contra a API do colégio. Nunca guarda senha.
model TentativaAuth {
  id            String   @id @default(cuid())
  escopo        String
  identificador String
  ip            String?
  sucesso       Boolean
  motivo        String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([escopo, identificador, createdAt])
  @@index([createdAt])
  @@map("tentativas_auth")
}

/// Balde de rate limiting. A contagem é incrementada por um único INSERT ... ON CONFLICT,
/// nunca por leitura seguida de escrita no JavaScript, para não perder contagem sob corrida.
model BaldeRate {
  chave        String    @id
  escopo       String
  falhas       Int       @default(0)
  janelaInicio DateTime  @map("janela_inicio")
  bloqueadoAte DateTime? @map("bloqueado_ate")
  atualizadoEm DateTime  @map("atualizado_em")

  @@index([atualizadoEm])
  @@map("baldes_rate")
}
